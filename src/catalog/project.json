  "pages": [
    {
      "id": "BP-REQ-002",
      "title": "机器人分层播报与多人确认",
      "summary": "在修改商户中按金额阶梯配置 TG 播报群、确认人员和需确认人数。",
      "moduleCodes": ["ADMIN"],
      "doc": "机器人分层播报与多人确认-demo"
    },
    {
      "id": "BP-REQ-003",
      "title": "商户增加资金划转",
      "summary": "在蓝盛后台记录并处理商户间资金划转；订单明确付款商户、出账钱包、收款商户与入账钱包，完成后按双方实际发生账变的钱包写入对应流水。",
      "moduleCodes": ["ADMIN"],
      "doc": "商户增加资金划转-demo"
    },
    {
      "id": "BP-REQ-001",
      "title": "商户充值订单统计栏位",
      "summary": "在商户充值订单状态卡片与列表之间新增查询结果汇总统计。",
      "moduleCodes": ["ADMIN"],
      "doc": "商户充值订单统计栏位-demo"
    },
    {
      "id": "BP-REQ-004",
      "title": "VND 法币代收",
      "summary": "法币代收新增 VND 币种：商户下单传 VND，平台按汇率换算 USDT 收款，回调按 VND 金额；成功订单按原始 VND 金额累计商户今日成交，且不重复计入 USDT 今日成交。",
      "moduleCodes": ["ADMIN"],
      "doc": "机器人分层播报与多人确认-demo"
    },
    {
      "id": "BP-REQ-005",
      "title": "TRX 代收通道",
      "summary": "代收新增 TRX（同 USDT 虚拟币链路）：地址池归属沿用蓝盛，按币种锁定地址用途；商户仅能从既有商户下分发起 TRX 提现，不做 TRX 代付。",
      "moduleCodes": ["ADMIN", "MERCHANT", "ADDRESS"],
      "doc": "TRX代收通道-demo"
    },
    {
      "id": "BP-REQ-007",
      "title": "商户下分统计与导出",
      "summary": "在商户下分记录的筛选区下方按币种展示状态、申请金额、实际到账和手续费统计，并按当前筛选条件导出完整明细。",
      "moduleCodes": ["ADMIN"],
      "doc": "机器人分层播报与多人确认-demo"
    },
    {
      "id": "BP-REQ-006",
      "title": "TG 系统消息配置现状复刻",
      "summary": "复刻蓝盛后台 TG 系统消息配置的筛选、列表、新增编辑、启停、删除确认与特殊类型专属配置，作为后续新增消息类型的页面基线。",
      "moduleCodes": ["ADMIN"],
      "doc": "TG系统消息配置-demo"
    },
    {
      "id": "BP-REQ-008",
      "title": "商户端发起资金划转",
      "summary": "商户可向后台已绑定的目标商户发起资金划转；完成后，付款方在实际出账钱包查看负数转出及去向，收款方在实际入账钱包查看正数入账及来源。",
      "moduleCodes": ["MERCHANT"],
      "doc": "TRX代收通道-demo"
    },
    {
      "id": "BP-REQ-009",
      "title": "余额与资金划转 TG 通知人",
      "summary": "在余额提醒和资金划转配置中维护可选 TG 通知人；机器人向配置群播报时，有通知人则在消息内容中增加 @，未设置则仅群内播报。",
      "moduleCodes": ["ADMIN"],
      "doc": "机器人分层播报与多人确认-demo"
    },
    {
      "id": "BP-REQ-010",
      "title": "美人桥订单管理现状复刻",
      "summary": "复刻美人桥订单管理的筛选、提醒与维护开关、默认汇率、订单明细、汇总分页、人工上分和订单日志，作为后续需求迭代基线。",
      "moduleCodes": ["ADMIN"],
      "doc": "美人桥订单管理-demo"
    },
    {
      "id": "BP-REQ-011",
      "title": "美人桥商户端订单列表骨架",
      "summary": "新增美人桥商户端独立入口，复刻订单列表、筛选、添加编辑与分页；修改密码、备用网址和我的工单仅保留导航位置。",
      "moduleCodes": ["BEAUTY_MERCHANT"],
      "doc": "美人桥商户端订单列表-demo"
    },
    {
      "id": "BP-REQ-012",
      "title": "美人桥 TRX 充值并上分 CNY",
      "summary": "美人桥商户创建充值订单增加 TRX；TRX 与 USDT 一样由商户填写充值数量，系统读取并锁定美人桥订单管理页维护的 TRX/CNY 默认汇率，计算应上分 CNY。TRX 未启用默认汇率时禁止下单；USDT 未启用默认汇率时可回退线上 USDT/CNY。TRX 到账后直接上分 CNY，不经过 USDT 中转。",
      "moduleCodes": ["ADMIN", "BEAUTY_MERCHANT"],
      "doc": "美人桥商户端订单列表-demo"
    },
    {
      "id": "BP-REQ-013",
      "title": "登录失败临时封锁与后台解锁",
      "summary": "复用系统管理下的封禁IP管理入口：登录密码或Google验证码在5分钟内累计错误5次时自动封锁IP 24小时，并支持按权限手动解除及保留审计记录。",
      "moduleCodes": ["ADMIN"],
      "doc": "封禁IP管理-demo"
    },
    {
      "id": "BP-REQ-014",
      "title": "美人桥统计报表多币种展示",
      "summary": "在蓝盛后台美人桥统计报表中，将今日充值、应转U调整为上分金额（CNY）、充值数量，新增充值币种并按币种分行；归属收款统计报表补充演示数据与TRX充值数量。",
      "moduleCodes": ["ADMIN"],
      "doc": "美人桥统计报表-demo"
    }
  ],
