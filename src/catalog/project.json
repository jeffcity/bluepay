  "pages": [
    {
      "id": "BP-REQ-002",
      "title": "机器人分层播报与多人确认",
      "summary": "在修改商户中按金额阶梯配置 TG 播报群、确认人员和需确认人数。",
      "moduleCodes": ["ADMIN"],
      "doc": "机器人分层播报与多人确认-demo"
    },
    {
      "id": "BP-REQ-003",
      "title": "商户增加资金划转",
      "summary": "在蓝盛后台配置双向商户互转关系；代收 USDT余额与代付 USDT代付剩余预付均可任选为来源或目标。",
      "moduleCodes": ["ADMIN"],
      "doc": "机器人分层播报与多人确认-demo"
    },
    {
      "id": "BP-REQ-001",
      "title": "商户充值订单统计栏位",
      "summary": "在商户充值订单状态卡片与列表之间新增查询结果汇总统计。",
      "moduleCodes": ["ADMIN"],
      "doc": "商户充值订单统计栏位-demo"
    },
    {
      "id": "BP-REQ-004",
      "title": "VND 法币代收",
      "summary": "法币代收新增 VND 币种：商户下单传 VND，平台按汇率换算 USDT 收款，回调按 VND 金额；复用虚拟币充值配置与订单管理的既有字段和流程。",
      "moduleCodes": ["ADMIN"],
      "doc": "VND法币代收-demo"
    },
    {
      "id": "BP-REQ-005",
      "title": "TRX 代收通道",
      "summary": "代收新增 TRX（同 USDT 虚拟币链路）：地址池归属沿用蓝盛，按币种锁定地址用途；商户仅能从既有商户下分发起 TRX 提现，不做 TRX 代付。",
      "moduleCodes": ["ADMIN", "MERCHANT", "ADDRESS"],
      "doc": "TRX代收通道-demo"
    },
    {
      "id": "BP-REQ-007",
      "title": "商户下分统计与导出",
      "summary": "在商户下分记录的筛选区下方按币种展示状态、申请金额、实际到账和手续费统计，并按当前筛选条件导出完整明细。",
      "moduleCodes": ["ADMIN"],
      "doc": "机器人分层播报与多人确认-demo"
    },
    {
      "id": "BP-REQ-006",
      "title": "TG 系统消息配置现状复刻",
      "summary": "复刻蓝盛后台 TG 系统消息配置的筛选、列表、新增编辑、启停、删除确认与特殊类型专属配置，作为后续新增消息类型的页面基线。",
      "moduleCodes": ["ADMIN"],
      "doc": "TG系统消息配置-demo"
    },
    {
      "id": "BP-REQ-008",
      "title": "商户端发起资金划转",
      "summary": "在商户下发提现页新增资金划转入口，商户仅可向后台已绑定的目标商户发起既有划转流程。",
      "moduleCodes": ["MERCHANT"],
      "doc": "TRX代收通道-demo"
    }
